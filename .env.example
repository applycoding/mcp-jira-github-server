# Copy to a shell or a client config. Do not commit real tokens.
# Default mode needs none of the credentials below.

MCP_BACKEND=mock
MCP_READ_ONLY=false
MCP_TOOL_ALLOWLIST=
JIRA_PROJECT_ALLOWLIST=
GITHUB_REPO_ALLOWLIST=
MCP_RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# Live mode only (Jira Cloud email + API token, GitHub personal access token).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
